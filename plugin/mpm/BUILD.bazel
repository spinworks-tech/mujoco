# An engine plugin which simulates sand, liquids and elastic solids with the material point method.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:build_defs.bzl", "MJ_ROOT")

cc_library(
    name = "mpm",
    srcs = ["mpm.cc"],
    hdrs = ["mpm.h"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-ffp-contract=off",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    deps = [
        "//:libmujoco_hdrs",
        "//src/engine",  # buildcleaner: keep
    ],
)

cc_library(
    name = "register",
    srcs = [
        "register.cc",
    ],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT + "/src",
        "-ffp-contract=off",
        "-fvisibility=hidden",
    ],
    cxxopts = [
        "-fvisibility-inlines-hidden",
        "-std=c++20",
    ],
    linkstatic = True,
    local_defines = [
        "MUJOCO_DLL_EXPORTS",
        "_GNU_SOURCE",
    ],
    visibility = ["//:visibility"],
    deps = [
        ":mpm",
        "//:libmujoco_hdrs",
    ],
    alwayslink = 1,
)
