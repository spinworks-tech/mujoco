# Tests for mujoco/plugin/mpm

load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//:build_defs.bzl", "MJ_ROOT")

licenses(["notice"])

cc_test(
    name = "mpm_test",
    timeout = "long",
    srcs = ["mpm_test.cc"],
    conlyopts = ["-std=c11"],
    copts = [
        "-I" + MJ_ROOT,
        "-I" + MJ_ROOT + "/src",
        "-ffp-contract=off",
    ],
    cxxopts = ["-std=c++20"],
    # unoptimized (bazel's default fastbuild), the particle simulations take minutes
    shard_count = 4,
    deps = [
        "//:mujoco",
        "//plugin/mpm:register",
        "//test:fixture",
        "@abseil-cpp//absl/strings",
        "@googletest//:gtest_main",
    ],
)
